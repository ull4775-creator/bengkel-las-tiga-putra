APP_NAME="Bengkel Las Tiga Putra"
APP_ENV=production
APP_KEY=base64:mDCQpDy6H6kg1iKDWoNpR49wnb7p9qYGB9ewREHujOc=
APP_DEBUG=false
ASSET_URL=https://bengkel-las-tiga-putra.vercel.app

# Vercel tidak punya database MySQL, gunakan SQLite di folder temporary
DB_CONNECTION=sqlite
DB_DATABASE=/tmp/database.sqlite

# Cache dan Session HARUS menggunakan driver 'array' atau 'cookie' di Vercel
# Karena filesystem Vercel bersifat read-only (tidak bisa menulis file cache)
CACHE_DRIVER=array
SESSION_DRIVER=cookie
QUEUE_CONNECTION=sync

LOG_CHANNEL=stderr
VIEW_COMPILED_PATH=/tmp/views